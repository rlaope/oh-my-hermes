{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omher",
  "version": "0.2.5",
  "identifier": "dev.ohmyhermes.omher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5207",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "omher",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../bridge/omher_bridge.py": "bridge/omher_bridge.py"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Your Hermes bots in one window",
    "copyright": "MIT License, oh-my-hermes contributors",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMTRFOUQyNjMxNjQyNDUKUldSRlFoWmowdWtVSDZ1YTQ4VS9VcVZsNm9UcW03MUJKWU8zREw0cWlBTzA3TGw5K0RhdUpYR3gK",
      "endpoints": [
        "https://github.com/rlaope/oh-my-hermes/releases/download/omher-latest/latest.json"
      ]
    }
  }
}
