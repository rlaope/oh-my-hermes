# The installers are checked byte-for-byte by tests/test_windows_install_path.py
# and are served raw to `sh` and `iex` pipelines, so their line endings have to
# be the same on every checkout. Without this, git's Windows autocrlf rewrites
# install.ps1 to CRLF on checkout and the encoding gate fails on windows-latest.
install.sh  text eol=lf
install.ps1 text eol=lf

# Generated skill bodies and references are compared byte-for-byte against their
# producers (tests/test_agent_board_kanban.py K7, docs --check gates), so their
# line endings must be identical on every checkout.
skills/**/*.md text eol=lf
agent-skills/**/*.md text eol=lf
# Canonical and projected UTF-8 companion bytes are digest-bound on every OS.
src/skills/ai_job_search_toolkit/** text eol=lf
skills/omh-ai-job-search/toolkit/** text eol=lf
agent-skills/omh-ai-job-search/toolkit/** text eol=lf
src/skills/show_reel_toolkit/** text eol=lf
skills/omh-show-reel/toolkit/** text eol=lf
agent-skills/omh-show-reel/toolkit/** text eol=lf
src/skills/geospatial_analysis_toolkit/** text eol=lf
skills/omh-geospatial-analysis/toolkit/** text eol=lf
agent-skills/omh-geospatial-analysis/toolkit/** text eol=lf
src/skills/sprite_forge_toolkit/** text eol=lf
skills/omh-sprite-forge/toolkit/** text eol=lf
agent-skills/omh-sprite-forge/toolkit/** text eol=lf
src/skills/biomedical_evidence_toolkit/** text eol=lf
skills/omh-biomedical-evidence/toolkit/** text eol=lf
agent-skills/omh-biomedical-evidence/toolkit/** text eol=lf
src/skills/molecular_docking_toolkit/** text eol=lf
skills/omh-molecular-docking/toolkit/** text eol=lf
agent-skills/omh-molecular-docking/toolkit/** text eol=lf
# The pack's digest inventory, copied verbatim as every installer's receipt.
agent-skills/.omh-agent-skills-manifest.json text eol=lf

# Generated clone adapters are byte-gated on POSIX and Windows. Keep scripts
