  "scenarios": [
    {
      "id": "ai-schedule-weekday-morning-status",
      "category": "schedule",
      "request": "Every weekday at 9am, check https://status.example.com and tell me here if anything is degraded.",
      "prior_state": {
        "user_timezone": "Asia/Seoul"
      },
      "expect": {
        "outcome": "prepared_automation",
        "automation": {
          "schedule": [
            "0 9 * * 1-5",
            "0 9 * * mon-fri"
          ],
          "timezone": [
            "Asia/Seoul"
          ],
          "deliver": [
            "origin"
          ],
          "target": {
            "kind": "url",
            "ref": "https://status.example.com"
          },
          "filters": {},
          "silence": "only_report_changes",
          "optional_filters": {
            "keywords": [
              "degraded",
              "degradation"
            ]
          }
        }
      },
      "why": "Weekdays at a named hour is a cron range over Monday to Friday, in the person's own timezone. 'Tell me if anything is degraded' means silence on a healthy run."
    },
    {
      "id": "ai-schedule-every-two-hours-feed",
      "category": "schedule",
      "request": "Check the RSS feed at https://blog.example.com/feed.xml every 2 hours and post any new article here.",
      "prior_state": {
        "user_timezone": "Europe/Berlin"
      },
      "expect": {
        "outcome": "prepared_automation",
        "automation": {
          "schedule": [
            "every 2h",
            "0 */2 * * *"
          ],
          "deliver": [
            "origin"
          ],
          "target": {
            "kind": "rss_feed",
            "ref": "https://blog.example.com/feed.xml"
          },
          "filters": {},
          "silence": "only_report_changes"
        }
      },
      "why": "An interval, not a time of day: 'every 2 hours' is Hermes' interval form or its cron equivalent. Only new articles are posted, so a run with none stays silent."
    },
